# ==============================================================================
# PDF24x7 - Centralized Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file with production keys to Git.
# See ENV_SETUP.md and SUPABASE_SETUP.md for complete configuration guides.
# ==============================================================================

# SUPABASE CONFIGURATION (Client & Backend)
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# GOOGLE OAUTH CONFIGURATION (Client-Safe Web Client ID)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=

# RESEND EMAIL CONFIGURATION (Server-Side ONLY - For Supabase Edge Functions)
# Obtain from: https://resend.com/api-keys
# NEVER include RESEND_API_KEY in the Android application client.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=PDF24x7

# APP CONFIGURATION
APP_NAME=PDF24x7
APP_SUPPORT_EMAIL=
APP_FEEDBACK_EMAIL=
APP_WEBSITE_URL=
