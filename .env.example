# ==============================================================================
# PDF24x7 Environment Configuration Guide (.env.example)
#
# NOTE: Never commit live production secrets, private keys, or service-role keys.
# Use this template to configure your local, CI, or Vercel production environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Auth & Backend Configuration (Client & Edge)
# ------------------------------------------------------------------------------
# In your Supabase Dashboard (https://supabase.com):
# - Project Settings -> API: Copy "Project URL" and "anon public" key.
# - Authentication -> URL Configuration: Add Redirect URL:
#     com.pandu78.pdf24x7://auth-callback
# - Authentication -> Providers: Enable Email / Password & Google OAuth.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Custom scheme for mobile OAuth callbacks (registered in AndroidManifest.xml)
SUPABASE_REDIRECT_URL=com.pandu78.pdf24x7://auth-callback

# ------------------------------------------------------------------------------
# 2. Resend Email Delivery (Vercel Serverless Function: /api/feedback)
# ------------------------------------------------------------------------------
# In your Resend Dashboard (https://resend.com):
# - API Keys: Create an API key with sending permissions.
# - Domains: Verify your sending domain (e.g., pdf24x7.com).
# Configure these variables in Vercel Project Settings -> Environment Variables:
RESEND_API_KEY=re_your_resend_api_key_here
FEEDBACK_TO_EMAIL=support@pdf24x7.com
FEEDBACK_FROM_EMAIL=PDF24x7 Support <feedback@pdf24x7.com>

# Client-facing Feedback endpoint (points to your deployed Vercel domain):
FEEDBACK_ENDPOINT_URL=https://your-deployment.vercel.app/api/feedback

# ------------------------------------------------------------------------------
# 3. Advertising Provider Configuration (Future Ads Readiness)
# ------------------------------------------------------------------------------
# When integrating Google AdMob or an ad mediation partner:
# - Set AD_PROVIDER to "ADMOB", "APPLOVIN", or "NONE"
# - Use test ad unit IDs during development.
AD_PROVIDER=NONE
ADMOB_APP_ID=ca-app-pub-0000000000000000~0000000000
ADMOB_HOME_BANNER_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_TOOLS_BANNER_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712

# ------------------------------------------------------------------------------
# 4. Android Release Signing (Local Gradle - ~/.gradle/gradle.properties)
# ------------------------------------------------------------------------------
# Keep release keystores and passwords out of this repository.
# Place these variables in your user home directory (~/.gradle/gradle.properties):
# PDF_TOOLS_UPLOAD_STORE_FILE=/path/to/upload.jks
# PDF_TOOLS_UPLOAD_STORE_PASSWORD=your_keystore_password
# PDF_TOOLS_UPLOAD_KEY_ALIAS=your_key_alias
# PDF_TOOLS_UPLOAD_KEY_PASSWORD=your_key_password

