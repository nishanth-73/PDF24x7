{
  "expo": {
    "name": "PDF Tools",
    "slug": "pdf-app",
    "scheme": "pdftools",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "com.sammyi57.pdftools",
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.sammyi57.pdftools",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "PDF Tools uses the camera to scan documents into PDFs. Photos are processed on your device.",
          "microphonePermission": false,
          "photosPermission": "PDF Tools opens photos you pick to turn them into PDF pages."
        }
      ],
      "expo-router",
      "./plugins/withMaxRefreshRate",
      "./plugins/withArm64Only",
      "./plugins/withReleaseSigning",
      "./plugins/withNoSplash",
      "./plugins/withNightBackground",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "extraProguardRules": "-keep class org.opencv.** { *; }"
          }
        }
      ]
    ]
  }
}
